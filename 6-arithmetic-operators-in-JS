/**
* arithmetic operators
* toán tử số học
* + --> additional (cộng)
* - --> subtraction (trừ)
* * --> multiplication (nhân)
* ** --> exponentiation (lũy thừa)
* / --> division (chia)
* % --> modulus (chia lấy số dư)
* ++ --> increment (tăng 1 giá tri)
* -- --> decrement (giảm 1 giá trị)
*/

//additional (cộng)
var a = 2
var b = 3
var c= a+b
console.log (c)
//subtraction (trừ)
var d= a-b
console.log (d)
//multiplication (nhân)
var e= a*b
console.log (e)
//exponentiation (lũy thừa)
var f= a**b
console.log (f)
//division (chia)
var g= a/b
console.log (g)
//modulus (chia lấy số dư) để so sánh số chẵ (even), số lẻ (odd)
var h= a%b
console.log (h)
//increment (tăng 1 giá tri)
a++
console.log (a)
//decrement (giảm 1 giá trị)
b--
b--
console.log (b)
