/**
* Toán tử
* Toán tử là công cụ dùng để thực hiện các phép tính hoặc chức năng với dữ liệu
* trong lập trình được thể hiện dưới dạng ký hiệu, biểu tượng nhằm thực hiện các biểu thức.
* 1.Toán tử số học- arithmetic operators
* 2.Toán tử gán- assignment operators
* 3.Toán tử so sánh- comparision operators
* 4.Toán tử logic- logical operators
*/
//arithmetic operators
var a= 1+2
console.log (a)
//assignment operators
var fullname= 'Vy'
console.log (fullname)
//comparision operators
//toán tử so sánh là ==, 1 dấu = là toán tử gán
var a= 1
var b= 2
if (a<b)
{
console.log ('đúng');
}
//logical operators
//example: &&
var a = 1
var b = 2
if (a>0 && b>0)
{
alert ('a và b >0')
}
