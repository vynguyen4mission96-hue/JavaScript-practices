/**
* Logical operators in Javascript
* Toán tử logic
* 1. &&- AND
* 2.|| - OR
* 3. ! - NOT
*
*/

//&&- AND
var a= 1
var b= 2
var c= 3
if (a> 1 && b> 1 && c> 1)// a is NOT greater than 1, so this "Dieu kien 1" is failed
{
console.log('Dieu kien 1 Dung!')
}
// ||- OR
var d= 5
var e= 0
if (d> 1 || e> 1)
{
console.log('Dieu kien 2 Dung!')
}
// ! -MOT

var f=2
var g =0
if (!(f <0)) // means f>0
{
console.log('Dieu kien 3 Dung!')
}

if (!(g >0)) // means f>0
{
console.log('Dieu kien 4 Dung!')
}
